rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return signedIn() && exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isActive() {
      return userExists(request.auth.uid)
        && userData(request.auth.uid).accountStatus == 'active'
        && request.auth.token.email_verified == true;
    }

    function hasRole(role) {
      return isActive() && userData(request.auth.uid).role == role;
    }

    function isPetOwner(petId) {
      return isActive()
        && exists(/databases/$(database)/documents/pets/$(petId))
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }

    function hasVetAccess(petId) {
      return hasRole('veterinarian')
        && exists(/databases/$(database)/documents/petAccess/$(petId)/veterinarians/$(request.auth.uid))
        && get(/databases/$(database)/documents/petAccess/$(petId)/veterinarians/$(request.auth.uid)).data.active == true;
    }

    function ownsShelter(shelterId) {
      return hasRole('shelterAdmin')
        && exists(/databases/$(database)/documents/shelters/$(shelterId))
        && get(/databases/$(database)/documents/shelters/$(shelterId)).data.adminId == request.auth.uid;
    }

    function immutable(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['petOwner', 'veterinarian', 'shelterAdmin']
        && request.resource.data.accountStatus == 'pendingEmailVerification'
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'role', 'accountStatus',
          'photoUrl', 'createdAt', 'updatedAt'
        ]);
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && (
        immutable(['name', 'phone', 'photoUrl', 'updatedAt'])
        || (
          resource.data.accountStatus == 'pendingEmailVerification'
          && request.resource.data.accountStatus == 'active'
          && request.auth.token.email_verified == true
          && immutable(['accountStatus', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if isActive() && request.auth.uid == uid;
      allow create, update: if isActive()
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.token is string
        && request.resource.data.platform in ['android', 'iOS', 'web', 'macOS', 'windows', 'linux'];
    }

    match /publicProfiles/{uid} {
      allow read: if isActive();
      allow write: if false;
    }

    match /pets/{petId} {
      allow create: if hasRole('petOwner')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'species', 'breed', 'age', 'gender',
          'photoPath', 'createdAt', 'updatedAt'
        ]);
      allow read: if isActive() && (
        resource.data.ownerId == request.auth.uid || hasVetAccess(petId)
      );
      allow update: if hasRole('petOwner')
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if hasRole('petOwner') && resource.data.ownerId == request.auth.uid;
    }

    match /petAccess/{petId}/veterinarians/{vetId} {
      allow read, write: if false;
    }

    match /petHealthRecords/{recordId} {
      allow create: if hasRole('veterinarian')
        && request.resource.data.veterinarianId == request.auth.uid
        && hasVetAccess(request.resource.data.petId)
        && request.resource.data.keys().hasOnly([
          'petId', 'veterinarianId', 'diagnosis', 'treatment',
          'prescription', 'date', 'followUpDate', 'reportPaths',
          'createdAt', 'updatedAt'
        ]);
      allow read: if isPetOwner(resource.data.petId) || hasVetAccess(resource.data.petId);
      allow update: if hasRole('veterinarian')
        && resource.data.veterinarianId == request.auth.uid
        && hasVetAccess(resource.data.petId)
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.veterinarianId == resource.data.veterinarianId;
      allow delete: if hasRole('veterinarian')
        && resource.data.veterinarianId == request.auth.uid
        && hasVetAccess(resource.data.petId);
    }

    match /appointments/{appointmentId} {
      allow create: if hasRole('petOwner')
        && request.resource.data.ownerId == request.auth.uid
        && isPetOwner(request.resource.data.petId)
        && userData(request.resource.data.veterinarianId).role == 'veterinarian'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'petId', 'ownerId', 'veterinarianId', 'dateTime', 'reason',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow read: if isActive() && (
        resource.data.ownerId == request.auth.uid
        || resource.data.veterinarianId == request.auth.uid
      );
      allow update: if isActive()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.veterinarianId == resource.data.veterinarianId
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.status in ['pending', 'cancelled']
            && immutable(['dateTime', 'reason', 'status', 'updatedAt'])
          )
          || (
            hasRole('veterinarian')
            && resource.data.veterinarianId == request.auth.uid
            && request.resource.data.status in ['confirmed', 'completed', 'cancelled']
            && immutable(['dateTime', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /vetAvailability/{slotId} {
      allow read: if isActive();
      allow create: if hasRole('veterinarian')
        && request.resource.data.veterinarianId == request.auth.uid
        && request.resource.data.isBooked == false;
      allow update: if hasRole('veterinarian')
        && resource.data.veterinarianId == request.auth.uid
        && request.resource.data.veterinarianId == resource.data.veterinarianId
        && request.resource.data.isBooked == resource.data.isBooked;
      allow delete: if hasRole('veterinarian')
        && resource.data.veterinarianId == request.auth.uid
        && resource.data.isBooked == false;
    }

    match /shelters/{shelterId} {
      allow create: if hasRole('shelterAdmin')
        && request.resource.data.adminId == request.auth.uid;
      allow read: if isActive();
      allow update: if ownsShelter(shelterId)
        && request.resource.data.adminId == resource.data.adminId;
      allow delete: if ownsShelter(shelterId);
    }

    match /adoptionListings/{listingId} {
      allow read: if isActive() && (
        resource.data.status in ['available', 'pending', 'adopted']
        || ownsShelter(resource.data.shelterId)
      );
      allow create: if hasRole('shelterAdmin')
        && request.resource.data.adminId == request.auth.uid
        && ownsShelter(request.resource.data.shelterId)
        && request.resource.data.status == 'available';
      allow update: if ownsShelter(resource.data.shelterId)
        && request.resource.data.shelterId == resource.data.shelterId
        && request.resource.data.adminId == resource.data.adminId
        && request.resource.data.status in ['available', 'pending', 'adopted'];
      allow delete: if ownsShelter(resource.data.shelterId);
    }

    match /adoptionRequests/{requestId} {
      allow create: if hasRole('petOwner')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/adoptionListings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/adoptionListings/$(request.resource.data.listingId)).data.shelterId
          == request.resource.data.shelterId;
      allow read: if isActive() && (
        resource.data.ownerId == request.auth.uid || ownsShelter(resource.data.shelterId)
      );
      allow update: if ownsShelter(resource.data.shelterId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.shelterId == resource.data.shelterId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.status in ['approved', 'rejected', 'pending']
        && immutable(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /successStories/{storyId} {
      allow read: if isActive() && (resource.data.published == true || ownsShelter(resource.data.shelterId));
      allow create: if hasRole('shelterAdmin')
        && request.resource.data.adminId == request.auth.uid
        && ownsShelter(request.resource.data.shelterId);
      allow update: if ownsShelter(resource.data.shelterId)
        && request.resource.data.shelterId == resource.data.shelterId
        && request.resource.data.adminId == resource.data.adminId;
      allow delete: if ownsShelter(resource.data.shelterId);
    }

    match /volunteerRequests/{requestId} {
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid || ownsShelter(resource.data.shelterId)
      );
      allow update: if ownsShelter(resource.data.shelterId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.shelterId == resource.data.shelterId
        && immutable(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid || ownsShelter(resource.data.shelterId)
      );
      allow update: if ownsShelter(resource.data.shelterId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.shelterId == resource.data.shelterId
        && immutable(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isActive() && resource.data.active == true;
      allow write: if false;
    }

    match /wishlists/{uid}/items/{productId} {
      allow read, create, delete: if isActive() && request.auth.uid == uid;
      allow update: if false;
    }

    match /blogs/{blogId} {
      allow read: if isActive() && resource.data.published == true;
      allow write: if false;
    }

    match /bookmarks/{uid}/items/{blogId} {
      allow read, create, update, delete: if isActive() && request.auth.uid == uid;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if isActive() && request.auth.uid == uid;
      allow update: if isActive()
        && request.auth.uid == uid
        && immutable(['readAt']);
      allow create, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['suggestion', 'bug', 'feedback'];
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
